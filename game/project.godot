; Tiny 2D platformer for the Godot MCP lab. One player, one floor, one ledge, single jump.
config_version=5

[application]
config/name="MCP Lab Platformer"
run/main_scene="res://scenes/level.tscn"
config/features=PackedStringArray("4.7")

